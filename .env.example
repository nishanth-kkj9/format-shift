# Port for the Express API server (defaults to 4000)
PORT=4000

# Set to 1 to trust the first hop when behind a trusted reverse proxy
# (nginx, Cloudflare). Required for correct client IPs in rate limiting.
# TRUST_PROXY=1

# Set to 1 to send Strict-Transport-Security. Only enable when the site is
# served over HTTPS (usually behind a TLS-terminating proxy).
# ENABLE_HSTS=1

# Path to the ffmpeg binary. Defaults to the bundled ffmpeg-static (dev) or
# the ffmpeg on PATH. In the Docker image this is /usr/bin/ffmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Max concurrent ffmpeg processes (defaults to 2). The bounded queue holds up
# to 5x this many pending conversions; beyond that the API returns 503.
# Upper bound: 64.
# FFMPEG_MAX_CONCURRENCY=2

# ffmpeg timeout in milliseconds (defaults to 300000 = 5 minutes).
# Upper bound: 1800000 (30 minutes). A timed-out conversion returns 504.
# FFMPEG_TIMEOUT_MS=300000

# Max bytes ffmpeg may write to its output file (defaults to 1 GiB). A
# conversion that exceeds this is killed and the API returns 413.
# Upper bound: 4294967296 (4 GiB).
# FFMPEG_MAX_OUTPUT_BYTES=1073741824

# Minimum ffmpeg version the ready/health gates accept (defaults to 4.2.0,
# the version that introduced the ico muxer the image pipeline needs).
# Must be a major.minor.patch version string.
# FFMPEG_MIN_FEATURE_VERSION=4.2.0

# Oldest ffmpeg release considered secure (defaults to 5.1.9, the current
# security-patched baseline shipped by Debian bookworm / node:22-slim — Debian
# backports security fixes to the 5.1 branch). Treat this as a maintained
# patch-freshness policy: bump it alongside the runtime image's ffmpeg package
# updates. Must be a major.minor.patch version string.
# FFMPEG_MIN_SECURITY_VERSION=5.1.9